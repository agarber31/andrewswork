{
  "name": "data-tracking",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  // Static files served directly by Cloudflare (not bundled into the
  // Worker script). profile.mp4 goes here. Requests to /profile.mp4 are
  // served automatically; every other path still runs the Worker as normal.
  "assets": {
    "directory": "./public"
  },

  // Two KV namespaces are required. Create them in the Cloudflare dashboard
  // (Storage & Databases -> KV) or with:
  //   npx wrangler kv namespace create SITE_DATA
  //   npx wrangler kv namespace create TOKEN_CACHE
  // Paste each real "id" below — these must NOT be left as placeholders.
"kv_namespaces": [
  { "binding": "SITE_DATA", "id": "46ee89c447134417988afc578b87c6e0" },
  { "binding": "TOKEN_CACHE", "id": "18b063361d2b4f8a9e7222808a29c628" }
],

  // Non-secret config. Secrets (passcodes, API keys) are set separately in
  // Cloudflare dashboard -> data-tracking -> Settings -> Variables and
  // Secrets, and must NOT be added here since this file is committed.
  "vars": {
    "GA4_PROPERTY_ID": "280166345",
    "TOOL_LAUNCH_DATE": "2026-08-07"
  }

  // No "routes" block: andrewswork.com is attached via Workers & Pages ->
  // data-tracking -> Settings -> Domains & Routes -> Custom Domains, which
  // manages its own DNS record and SSL certificate. A manual route entry
  // here would duplicate/conflict with that.
}
