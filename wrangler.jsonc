{
  "name": "data-tracking",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  // Two KV namespaces are required. Create them with:
  //   npx wrangler kv namespace create SITE_DATA
  //   npx wrangler kv namespace create TOKEN_CACHE
  // Then paste the "id" each command prints into the values below.
  "kv_namespaces": [
    { "binding": "SITE_DATA", "id": "REPLACE_WITH_SITE_DATA_KV_ID" },
    { "binding": "TOKEN_CACHE", "id": "REPLACE_WITH_TOKEN_CACHE_KV_ID" }
  ],

  // Non-secret config. Secrets (passcodes, API keys) are set separately —
  // see README.md — and must NOT be added here since this file is committed.
  "vars": {
    "GA4_PROPERTY_ID": "REPLACE_WITH_YOUR_GA4_PROPERTY_ID",
    "TOOL_LAUNCH_DATE": "2026-08-07"
  },

  // Point this at your real domain once it's added to Cloudflare.
  // Remove this block entirely if you only want the workers.dev URL for now —
  // but note Cloudflare Access cannot protect the workers.dev URL, only a
  // custom domain/route, so /analytics needs this configured before Access
  // setup is meaningful.
  "routes": [
    { "pattern": "andrewswork.com/*", "zone_name": "andrewswork.com" }
  ]
}
